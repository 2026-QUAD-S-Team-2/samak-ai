{
  "openapi": "3.1.0",
  "info": {
    "title": "Samak AI - Image Analyze MVP",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/analyze/image": {
      "post": {
        "tags": [
          "analyze"
        ],
        "summary": "Analyze Image",
        "description": "POST /v1/analyze/image\n\n- application/json: imageUrls(필수, 1개 이상), countryCode(필수), salary(선택), debug(선택)\n  - 단일 입력 호환: imageUrl",
        "operationId": "analyze_image_v1_analyze_image_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AnalyzeImageResponse"
                    },
                    {
                      "$ref": "#/components/schemas/AnalyzeImagesResponse"
                    }
                  ],
                  "title": "Response Analyze Image V1 Analyze Image Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/wage-warning": {
      "post": {
        "tags": [
          "wage"
        ],
        "summary": "Wage Warning",
        "operationId": "wage_warning_v1_wage_warning_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WageWarningRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WageWarningResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeImageRequest": {
        "properties": {
          "imageUrls": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Imageurls",
            "description": "분석할 이미지 URL 목록 (http/https). 파일 업로드는 지원하지 않습니다.",
            "examples": [
              [
                "https://example.com/sample.png"
              ]
            ]
          },
          "countryCode": {
            "type": "string",
            "title": "Countrycode",
            "description": "요청 국가 코드(ISO 3166-1 alpha-2). 예: \"KR\", \"UA\"",
            "examples": [
              "UA"
            ]
          },
          "salaryText": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salarytext",
            "description": "(옵션) 급여 문자열. 예: \"3000000 KRW\", \"$300/day\". 값은 그대로 사용됩니다.",
            "examples": [
              "3000000 KRW"
            ]
          },
          "debug": {
            "type": "boolean",
            "title": "Debug",
            "description": "true면 서버 로그에 디버그 정보를 남깁니다(응답 스키마는 변경되지 않음).",
            "default": false,
            "examples": [
              false
            ]
          }
        },
        "type": "object",
        "required": [
          "imageUrls",
          "countryCode"
        ],
        "title": "AnalyzeImageRequest",
        "examples": [
          {
            "countryCode": "UA",
            "debug": false,
            "imageUrls": [
              "https://example.com/sample.png"
            ],
            "salaryText": "3000000 KRW"
          },
          {
            "countryCode": "KR",
            "debug": false,
            "imageUrls": [
              "https://example.com/sample.png"
            ]
          }
        ]
      },
      "AnalyzeImageResponse": {
        "properties": {
          "analysisId": {
            "type": "string",
            "format": "uuid",
            "title": "Analysisid",
            "description": "분석 요청의 고유 ID (UUID)",
            "examples": [
              "3fa85f64-5717-4562-b3fc-2c963f66afa6"
            ]
          },
          "fraudProbability": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "type": "number",
            "format": "float",
            "title": "Fraudprobability",
            "description": "사기 확률(0~1). OCR 실패 등으로 추론을 생략한 경우 null.",
            "examples": [
              0.8735
            ]
          },
          "riskScore": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Riskscore"
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL",
              "UNKNOWN"
            ],
            "title": "Risklevel"
          },
          "riskSignals": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Risksignals"
          },
          "travelBanRegionsMatched": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Travelbanregionsmatched"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "analysisId",
          "riskLevel",
          "message"
        ],
        "title": "AnalyzeImageResponse"
      },
      "AnalyzeImagesResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/AnalyzeImageResponse"
            },
            "type": "array",
            "title": "Results",
            "description": "이미지별 분석 결과 목록(요청 순서 보장)."
          }
        },
        "type": "object",
        "title": "AnalyzeImagesResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WageWarningData": {
        "properties": {
          "warningMessage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warningmessage",
            "description": "임금 경고 메시지. 경고 조건에 해당하지 않으면 null."
          }
        },
        "type": "object",
        "title": "WageWarningData"
      },
      "WageWarningRequest": {
        "properties": {
          "countryCode": {
            "type": "string",
            "title": "Countrycode",
            "description": "요청 국가 코드(ISO 3166-1 alpha-2). 예: \"KR\", \"UA\"",
            "examples": [
              "UA"
            ]
          },
          "salaryText": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Salarytext",
            "description": "(옵션) 시급(hourly) 기준 급여 텍스트(통화 포함). 예: \"KRW 12000/h\", \"₩12,000/hour\", \"USD 25/h\"",
            "examples": [
              "UAH 150/h"
            ]
          }
        },
        "type": "object",
        "required": [
          "countryCode"
        ],
        "title": "WageWarningRequest",
        "examples": [
          {
            "countryCode": "UA",
            "salaryText": "UAH 150/h"
          },
          {
            "countryCode": "KR",
            "salaryText": "KRW 12000/hour"
          },
          {
            "countryCode": "UA"
          }
        ]
      },
      "WageWarningResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "data": {
            "$ref": "#/components/schemas/WageWarningData"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "title": "WageWarningResponse"
      }
    }
  }
}