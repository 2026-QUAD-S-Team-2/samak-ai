# Inference model
MODEL_DIR=models/fraud-baseline
MODEL_VERSION=fraud-baseline-v1.0.0
MAX_TEXT_CHARS=20000

# Logging
LOG_LEVEL=INFO

# Optional external integrations (disabled by default)
EXTERNAL_TIMEOUT_SECONDS=10

# Local minimum wage dataset (hourly)
MIN_WAGE_DATA_PATH=resources/min_wage_hourly.json

# ILOSTAT
# - Indicator codes may vary; keep them configurable.
# - You may provide either:
#   1) A URL template (note: {country} will be ISO alpha-3, e.g. KOR, UKR):
#      https://api.ilostat.ilo.org/sdmx-json/data/{indicator}/{country}.A
#   2) A base URL (fallback appends /sdmx-json/data/{indicator}/{country}.A)
ILOSTAT_BASE_URL=https://api.ilostat.ilo.org/sdmx-json/data/{indicator}/{country}.A
# Examples (verify suitability for your policy: unit/currency/dimensions)
# - Average hourly earnings (supports filtering by sex/occupation/currency type): EAR_4HRL_SEX_OCU_CUR_NB_A
ILOSTAT_MIN_WAGE_INDICATOR=
ILOSTAT_AVG_WAGE_INDICATOR=EAR_4HRL_SEX_OCU_CUR_NB_A
ILOSTAT_MEDIAN_WAGE_INDICATOR=

ENABLE_MAPS=false
MAPS_API_KEY=your_google_maps_api_key

ENABLE_GEMINI=true
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash
