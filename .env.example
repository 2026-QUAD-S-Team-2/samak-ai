# Inference model
MODEL_DIR=models/fraud-baseline
MODEL_VERSION=fraud-baseline-v1.0.0
MAX_TEXT_CHARS=20000

# Logging
LOG_LEVEL=INFO

# Optional external integrations (disabled by default)
EXTERNAL_TIMEOUT_SECONDS=10

# ILOSTAT (or compatible wage data source)
# - Indicator codes may vary; keep them configurable.
# - If indicator envs are empty, wage warning will skip comparisons gracefully.
ILOSTAT_BASE_URL=
ILOSTAT_MIN_WAGE_INDICATOR=
ILOSTAT_AVG_WAGE_INDICATOR=
ILOSTAT_MEDIAN_WAGE_INDICATOR=

ENABLE_MAPS=true
MAPS_API_KEY=your_google_maps_api_key

ENABLE_GEMINI=true
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash
