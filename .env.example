# Inference model
MODEL_DIR=models/fraud-baseline
MODEL_VERSION=fraud-baseline-v1.0.0
MAX_TEXT_CHARS=20000

# Logging
LOG_LEVEL=INFO

# Optional external integrations (disabled by default)
EXTERNAL_TIMEOUT_SECONDS=10

# Local minimum wage dataset (hourly)
MIN_WAGE_DATA_PATH=resources/min_wage_hourly.json

ENABLE_MAPS=false
MAPS_API_KEY=your_google_maps_api_key

ENABLE_GEMINI=true
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash

# Google Cloud Pub/Sub
GCP_PROJECT_ID=project-54a9d2ef-86a7-48c8-af9
PUBSUB_REQUEST_SUBSCRIPTION=analysis-request-subscription
PUBSUB_RESULT_TOPIC=analysis-result-topic
PUBSUB_DLQ_SUBSCRIPTION=analysis-request-dead-letter-subscription
PUBSUB_RECONNECT_DELAY=5
# 로컬 개발 시 서비스 계정 키 파일 경로 (GCP 환경에서는 ADC가 자동으로 적용되므로 불필요)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
