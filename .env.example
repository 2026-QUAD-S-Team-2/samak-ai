# Inference model
MODEL_DIR=models/fraud-baseline
MODEL_VERSION=fraud-baseline-v1.0.0
MAX_TEXT_CHARS=20000

# Logging
LOG_LEVEL=INFO

# Optional external integrations (disabled by default)
EXTERNAL_TIMEOUT_SECONDS=10

# Local minimum wage dataset (hourly)
MIN_WAGE_DATA_PATH=resources/min_wage_hourly.json

ENABLE_MAPS=false
MAPS_API_KEY=your_google_maps_api_key

ENABLE_GEMINI=true
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash

# RabbitMQ
# RABBITMQ_URL은 docker-compose.yml이 아래 두 값으로 자동 조립
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_REQUEST_EXCHANGE=analysis-request-exchange
RABBITMQ_RESULT_EXCHANGE=analysis-result-exchange
RABBITMQ_REQUEST_QUEUE=analysis-request-queue
RABBITMQ_RESULT_QUEUE=analysis-result-queue
RABBITMQ_REQUEST_ROUTING_KEY=analysis-request-routing-key
RABBITMQ_RESULT_ROUTING_KEY=analysis-result-routing-key
RABBITMQ_PREFETCH=1
RABBITMQ_RECONNECT_DELAY=5
