# Gemini
GEMINI_API_KEY=your_gemini_api_key

# Google Maps (Places API + Geocoding API)
# 미설정 시 위치 조회 기능이 비활성화됩니다.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GEMINI_MODEL=gemini-2.5-flash

# Logging
LOG_LEVEL=INFO

# Google Cloud Pub/Sub
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_REQUEST_SUBSCRIPTION=analysis-request-subscription
PUBSUB_RESULT_TOPIC=analysis-result-topic
PUBSUB_DLQ_SUBSCRIPTION=analysis-request-dead-letter-subscription
PUBSUB_RECONNECT_DELAY=5
# 로컬 개발 시 서비스 계정 키 파일 경로 (GCP 환경에서는 ADC가 자동으로 적용되므로 불필요)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
